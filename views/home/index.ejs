<div>
  <!-- Formulario de carga de PDF -->
<div class="mb-8 p-4 bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700">

  <div class="bg-indigo-50 dark:bg-indigo-900 border border-indigo-200 dark:border-indigo-700 rounded-xl p-4 mb-6">
    <h2 class="text-lg font-semibold text-indigo-700 dark:text-indigo-300">
      Expensas – <%= metadata?.dinamicos?.aviso_pago?.periodo || "—" %>
    </h2>
    <p class="text-sm text-gray-600 dark:text-gray-300">
      Vencimiento:
      <strong><%= metadata?.dinamicos?.aviso_pago?.vencimiento || "—" %></strong>
    </p>
    <p class="text-sm text-gray-600 dark:text-gray-300">
      Archivo:
      <strong><% if (nombreArchivo) { 
        const nombreSinExt = nombreArchivo.replace(/\.(pdf|json)$/i, '');
    %>: <%= nombreSinExt %><% } %></strong>
    </p>
  </div>

  <form action="/procesar-pdf" method="POST" enctype="multipart/form-data" class="space-y-6">

    <!-- BOTONES INICIALES -->
    <div id="wizardButtons" class="flex justify-end gap-x-3 pt-6">
      <% if (jsonFiles.length > 0) { %>
        <button type="button" id="btnListado" class="rounded-md bg-indigo-600 hover:bg-indigo-500 px-4 py-2 text-sm font-semibold text-white shadow-sm">
          Listado ya procesado
        </button>
      <% } %>
      <button type="button" id="btnSubirPDF" class="rounded-md bg-indigo-600 hover:bg-indigo-500 px-4 py-2 text-sm font-semibold text-white shadow-sm">
        Subir un PDF nuevo
      </button>
    </div>

    <!-- SECCIÓN JSON EXISTENTE -->
    <div id="selectJsonDiv" class="hidden mt-4">
      <label class="block text-sm font-medium mb-1">Seleccionar PDF procesado:</label>
      <select id="jsonSelect" name="jsonSeleccionado"
        class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700
               bg-white dark:bg-gray-800 text-sm">
        <option value="">-- Seleccionar archivo --</option>
        <% jsonFiles.forEach(f => { %>
          <option value="<%= f %>"><%= f %></option>
        <% }) %>
      </select>
    </div>

    <!-- SECCIÓN SUBIR PDF -->
    <div id="uploadPdfDiv" class="hidden mt-4">
      <label class="block text-sm font-medium mb-1">Subí el PDF:</label>
      <input id="pdfInput" type="file" name="pdfFile" accept=".pdf"
        class="block w-full text-sm text-gray-500
               file:mr-4 file:py-2 file:px-4
               file:rounded-md file:border-0
               file:text-sm file:font-semibold
               file:bg-blue-50 file:text-blue-700">
    </div>

    <!-- BOTONES PROCESAR / CANCELAR -->
    <div id="wizardActions" class="flex justify-end gap-x-3 pt-6 hidden">
      <button type="button" id="btnCancelarWizard" class="rounded-md bg-white dark:bg-gray-700 px-4 py-2 text-sm font-semibold text-gray-900 dark:text-white shadow-sm ring-1 ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600">
        Cancelar
      </button>
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
        Procesar
      </button>
    </div>

  </form>

</div>


  <!-- Dashboard: Totales + chart -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="col-span-1 bg-white dark:bg-gray-800 shadow rounded-xl p-5 border border-gray-200 dark:border-gray-700">
      <p class="text-gray-500 dark:text-gray-400 text-sm">Unidades</p>
      <p class="text-3xl font-bold"><%= unidades.length %></p>
    </div>
    <div class="col-span-1 bg-white dark:bg-gray-800 shadow rounded-xl p-5 border border-gray-200 dark:border-gray-700">
      <p class="text-gray-500 dark:text-gray-400 text-sm">Saldo Pendiente</p>
      <% const saldoPendiente = totales.sdo_pendiente || '0,00'; %>
      <p class="text-2xl font-semibold text-red-600 dark:text-red-400">$ <%= saldoPendiente %></p>
    </div>
    <div class="col-span-1 bg-white dark:bg-gray-800 shadow rounded-xl p-5 border border-gray-200 dark:border-gray-700">
      <p class="text-gray-500 dark:text-gray-400 text-sm">Total a recaudar</p>
      <% 
        let totalRecaudar = 0; 
        unidades.forEach(u => { 
          const valor = u.total ? parseFloat(u.total.replace(/\./g, '').replace(',', '.')) : 0;
          if (!isNaN(valor)) totalRecaudar += valor;
        }); 
        const totalFmt = totalRecaudar.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); 
      %>
      <p class="text-2xl font-semibold text-green-600 dark:text-green-400">$ <%= totalFmt %></p>
    </div>
  </div>

  <!-- BUSCADOR -->
  <input id="searchInput" type="text" placeholder="Buscar por nombre, UNI, piso o dpto…" 
    class="mb-4 w-full px-4 py-2 rounded-lg border border-gray-300 
           dark:border-gray-700 bg-white dark:bg-gray-800 
           text-gray-900 dark:text-gray-200" />

  <!-- TABLA -->
  <div class="overflow-hidden rounded-lg shadow border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 dark:bg-gray-700 text-gray-700 dark:text-gray-300 uppercase text-xs">
        <tr>
          <th class="px-4 py-3 text-left cursor-pointer sort" data-sort="uni">
            UNI <span class="sort-icon opacity-40">⇅</span>
          </th>
          <th class="px-4 py-3 text-left">Piso</th>
          <th class="px-4 py-3 text-left">Dpto</th>
          <th class="px-4 py-3 text-left cursor-pointer sort" data-sort="copropietario">
            Co-propietario <span class="sort-icon opacity-40">⇅</span>
          </th>
          <th class="px-4 py-3 text-right cursor-pointer sort" data-sort="total">
            Total a PAGAR <span class="sort-icon opacity-40">⇅</span>
          </th>
        </tr>
      </thead>

      <tbody id="tabla" class="divide-y divide-gray-200 dark:divide-gray-700">
        <% if (!unidades || unidades.length===0) { %>
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-gray-500">
              No se encontró información. Subí un PDF para procesar.
            </td>
          </tr>
        <% } else { unidades.forEach(u=> { %>
          <tr class="fila hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer transition"
              onclick="location.href='/detalle/<%= u.uni %>'"
              data-search="<%= (u.uni + ' ' + u.ps + ' ' + u.dpto + ' ' + u.copropietario).toLowerCase() %>"
              data-uni="<%= u.uni %>"
              data-copropietario="<%= u.copropietario.toLowerCase() %>"
              data-total="<%= u.total ? u.total.replace(/\./g,'').replace(',','.') : 0 %>">

            <td class="px-4 py-3 font-semibold"><%= u.uni %></td>
            <td class="px-4 py-3"><%= u.ps %></td>
            <td class="px-4 py-3"><%= u.dpto %></td>
            <td class="px-4 py-3"><%= u.copropietario %></td>
            <td class="px-4 py-3 text-right"><%= u.total %></td>

          </tr>
        <% }) } %>
      </tbody>
    </table>
  </div>
</div>

<script src="/js/home.js"></script>