<div class="max-w-3xl mx-auto">
  <a href="/" class="text-indigo-600 dark:text-indigo-400 hover:underline">&larr; Volver</a>

  <div class="max-w-3xl mx-auto">
    <!-- Sección CO-PROPIETARIO -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-xl p-6 border border-gray-200 dark:border-gray-700 mt-4 flex items-center space-x-4">
      <div class="p-4 bg-indigo-100 dark:bg-indigo-900 rounded-full">
        <i class="fas fa-user text-indigo-600 dark:text-indigo-300 text-3xl"></i>
      </div>
      <div>
        <h2 class="text-xl font-bold"><%= u.copropietario %></h2>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Piso: <span class="font-medium"><%= u.ps %></span> — Dpto: <span class="font-medium"><%= u.dpto %></span>
        </p>
      </div>
    </div>

    <!-- Sección MOVIMIENTOS -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-xl p-6 border border-gray-200 dark:border-gray-700 mt-4">
      <h2 class="text-xl font-semibold mb-4">MOVIMIENTOS</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <!-- Widget Saldo Anterior -->
        <div class="p-4 rounded-lg bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600">
          <div class="flex items-center space-x-3">
            <div class="p-2 bg-indigo-100 dark:bg-indigo-900 rounded-md">
              <i class="fas fa-history text-indigo-600 dark:text-indigo-300"></i>
            </div>
            <div>
              <p class="text-sm text-gray-600 dark:text-gray-300">Saldo Anterior</p>
              <p class="font-bold text-lg"><%= u.sdo_anterior %></p>
            </div>
          </div>
        </div>

        <!-- Widget Su Pago -->
        <div class="p-4 rounded-lg bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600">
          <div class="flex items-center space-x-3">
            <div class="p-2 bg-green-100 dark:bg-green-900 rounded-md">
              <i class="fas fa-money-bill text-green-600 dark:text-green-300"></i>
            </div>
            <div>
              <p class="text-sm text-gray-600 dark:text-gray-300">Su Pago</p>
              <p class="font-bold text-lg">
                <%= u.su_pago && u.su_pago !== "" ? u.su_pago : "0,00" %>
              </p>
            </div>
          </div>
        </div>
        <!-- Widget Pendiente -->
        <div class="p-4 rounded-lg bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600">
          <div class="flex items-center space-x-3">
            <div class="p-2 bg-amber-100 dark:bg-amber-900 rounded-md">
              <i class="fas fa-exclamation-circle text-amber-600 dark:text-amber-300"></i>
            </div>
            <div>
              <p class="text-sm text-gray-600 dark:text-gray-300">Saldo Pendiente</p>
              <p class="font-bold text-lg flex items-center gap-2">
                <span><%= u.sdo_pendiente || "0,00" %></span>
                <% if (u.interes && u.interes !== "0,00") { %>
                  <span class="text-amber-600 dark:text-amber-400 text-xs font-normal flex items-center gap-1">
                    - interés: $ <%= u.interes %>
                  </span>
                <% } %>
              </p>
            </div>
          </div>
        </div>

        <!-- Widget Total -->
        <div class="p-4 rounded-lg bg-indigo-50 dark:bg-indigo-900 border border-indigo-300 dark:border-indigo-700">
          <div class="flex items-center space-x-3">
            <div class="p-2 bg-indigo-100 dark:bg-indigo-800 rounded-md">
              <i class="fas fa-calculator text-indigo-700 dark:text-indigo-300"></i>
            </div>
            <div>
              <p class="text-sm text-indigo-700 dark:text-indigo-300 font-semibold">TOTAL A PAGAR</p>
              <p class="font-bold text-2xl"><%= u.total %></p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Sección de Información de la Unidad -->
    <div class="bg-white dark:bg-gray-800 shadow rounded-xl p-6 border border-gray-200 dark:border-gray-700 mt-6">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h2 class="text-xl font-semibold mb-1">INFORME DE LA UNIDAD</h2>
          <div class="text-sm text-gray-600 dark:text-gray-400">
            <p>Propietario: <span class="font-medium"><%= u.copropietario %></span></p>
            <p>Piso: <span class="font-medium"><%= u.ps %></span> - Dpto: <span class="font-medium"><%= u.dpto %></span></p>
          </div>
        </div>

        <button id="descargarPdf" class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 focus:outline-none">
          <i class="fas fa-file-pdf mr-2"></i>Descargar PDF
        </button>
      </div>

      <% if (u.documentacion?.actualizado) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
          Última actualización:
          <span class="fecha-actualizacion">
            <%= new Date(u.documentacion.actualizado).toLocaleString('es-AR', {
              timeZone: 'America/Argentina/Buenos_Aires',
              day: '2-digit',
              month: '2-digit',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            }) %>
          </span>
        </p>
      <% } %>

      <form id="unidadForm" class="space-y-10" enctype="multipart/form-data">

  <!-- HIDDEN FIELDS -->
  <input type="hidden" name="uni" id="uniField" value="<%= u.uni %>">
  <input type="hidden" name="ps" id="psField" value="<%= u.ps %>">
  <input type="hidden" name="dpto" id="dptoField" value="<%= u.dpto %>">

  <!-- ============================= -->
  <!-- DATOS PERSONALES -->
  <!-- ============================= -->
  <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white">
      Datos personales
    </h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Información de contacto del responsable de la unidad.
    </p>
  </div>

  <div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- EMAIL -->
      <div class="sm:col-span-1">
        <label for="email" class="block text-sm font-medium text-gray-900 dark:text-gray-300">
          Email
        </label>
        <div class="mt-2">
          <input type="email" id="email" name="email"
            value="<%= u.documentacion?.email || '' %>"
            class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed" <%= !isAuthenticated ? 'disabled' : '' %>>
        </div>
      </div>

      <!-- TELEFONO -->
      <div class="sm:col-span-1">
        <label for="telefono" class="block text-sm font-medium text-gray-900 dark:text-gray-300">
          Teléfono
        </label>
        <div class="mt-2">
          <input type="tel" id="telefono" name="telefono"
            value="<%= u.documentacion?.telefono || '' %>"
            class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed" <%= !isAuthenticated ? 'disabled' : '' %>>
        </div>
      </div>

    </div>
  </div>

  <!-- ============================= -->
  <!-- AREAS DE TEXTO -->
  <!-- ============================= -->
  <div class="border-b border-gray-200 dark:border-gray-700 pb-6 pt-10">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white">
      Estado y trabajos
    </h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Describe el estado actual y los trabajos relacionados con la unidad.
    </p>
  </div>

  <div class="space-y-6">

    <!-- ESTADO DEL INFORME -->
    <div>
      <label for="estadoInforme" class="block text-sm font-medium text-gray-900 dark:text-gray-300">
        Estado del Informe
      </label>
      <div class="mt-2">
        <% 
          const estadosPosibles = [
            "Informe sin presentar por el Co-propietario",
            "Informe presentado por Co-propietario",
            "Trabajos pendientes",
            "Trabajos en proceso",
            "Trabajos urgentes",
            "Trabajos finalizados"
          ];
          const estadoSeleccionado = u.documentacion?.estadoInforme || "Informe sin presentar por el Co-propietario";

          let colorClass = "border-gray-300 dark:border-gray-600 dark:text-white focus:border-indigo-500 focus:ring-indigo-500";
          if (estadoSeleccionado === "Trabajos urgentes") colorClass = "border-red-500 text-red-700 dark:text-red-400 focus:border-red-500 focus:ring-red-500";
          else if (estadoSeleccionado === "Trabajos finalizados") colorClass = "border-green-500 text-green-700 dark:text-green-400 focus:border-green-500 focus:ring-green-500";
          else if (estadoSeleccionado === "Trabajos en proceso") colorClass = "border-yellow-500 text-yellow-700 dark:text-yellow-400 focus:border-yellow-500 focus:ring-yellow-500";
          else if (estadoSeleccionado === "Trabajos pendientes") colorClass = "border-orange-500 text-orange-700 dark:text-orange-400 focus:border-orange-500 focus:ring-orange-500";
          else if (estadoSeleccionado === "Informe presentado por Co-propietario") colorClass = "border-blue-500 text-blue-700 dark:text-blue-400 focus:border-blue-500 focus:ring-blue-500";
        %>
        <select id="estadoInforme" name="estadoInforme"
          class="block w-full rounded-md bg-white dark:bg-gray-700 py-2 px-3 shadow-sm sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed <%= colorClass %>" <%= !isAuthenticated ? 'disabled' : '' %>>
          <% estadosPosibles.forEach(estado => { %>
            <option value="<%= estado %>" <%= estado === estadoSeleccionado ? 'selected' : '' %>><%= estado %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <!-- ESTADO ACTUAL -->
    <div>
      <label class="block text-sm font-medium text-gray-900 dark:text-gray-300">
        Estado Actual de la Unidad
      </label>
      <div class="mt-2">
        <textarea id="estadoActual" name="estadoActual" rows="3"
          class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed" <%= !isAuthenticated ? 'disabled' : '' %>><%= u.documentacion?.estadoActual || 'En buen estado' %></textarea>
      </div>
    </div>

    <!-- TRABAJOS NECESARIOS -->
    <div>
      <label class="block text-sm font-medium text-gray-900 dark:text-gray-300">
        Trabajos a Realizar <span class="mt-1 text-sm font-normal text-gray-500 dark:text-gray-400">(Trabajos iniciados por la actual administración)</span>
        <p class="mt-1 text-sm font-normal text-gray-500 dark:text-gray-400">
      Lista de trabajos que se necesitan realizar en la unidad.
        </p>
      </label>
      <div class="mt-2">
        <textarea id="trabajosNecesarios" name="trabajosNecesarios" rows="3"
          class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed" <%= !isAuthenticated ? 'disabled' : '' %>><%= u.documentacion?.trabajosNecesarios || 'Ninguno' %></textarea>
      </div>
    </div>

    <!-- TRABAJOS EN PROCESO -->
    <div>
      <label class="block text-sm font-medium text-gray-900 dark:text-gray-300">
        Trabajos en Curso
        <p class="mt-1 text-sm font-normal text-gray-500 dark:text-gray-400">
      Lista de trabajos que están en proceso de realización.
        </p>
      </label>
      <div class="mt-2">
        <textarea id="trabajosEnProceso" name="trabajosEnProceso" rows="3"
          class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed" <%= !isAuthenticated ? 'disabled' : '' %>><%= u.documentacion?.trabajosEnProceso || 'Ninguno' %></textarea>
      </div>
    </div>

    <!-- TRABAJOS COMPLETADOS -->
    <div>
      <label class="block text-sm font-medium text-gray-900 dark:text-gray-300">
        Trabajos Finalizados
        <p class="mt-1 text-sm font-normal text-gray-500 dark:text-gray-400">
      Lista de trabajos que han sido completados y no requieren más acción.
        </p>
      </label>
      <div class="mt-2">
        <textarea id="trabajosCompletados" name="trabajosCompletados" rows="3"
          class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed" <%= !isAuthenticated ? 'disabled' : '' %>><%= u.documentacion?.trabajosCompletados || 'Ninguno' %></textarea>
      </div>
    </div>

    <!-- OBSERVACIONES -->
    <div>
      <label class="block text-sm font-medium text-gray-900 dark:text-gray-300">
        Observaciones Adicionales
        <p class="mt-1 text-sm font-normal text-gray-500 dark:text-gray-400">
      Cualquier otra información relevante o comentarios.
        </p>
      </label>
      <div class="mt-2">
        <textarea id="observaciones" name="observaciones" rows="3"
          class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm disabled:opacity-60 disabled:cursor-not-allowed" <%= !isAuthenticated ? 'disabled' : '' %>><%= u.documentacion?.observaciones || '' %></textarea>
      </div>
    </div>

  </div>

  <!-- ============================= -->
  <!-- IMÁGENES -->
  <!-- ============================= -->
  <div class="border-b border-gray-200 dark:border-gray-700 pb-6 pt-10">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white">
      Imágenes
    </h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Visualiza las imágenes actuales o sube nuevas fotografías.
    </p>
  </div>

  <div class="space-y-6">

    <!-- EXISTING IMAGES -->
    <% if (u.documentacion?.imagenes && u.documentacion.imagenes.length > 0) { %>
      <div>
        <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Imágenes existentes
        </h4>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="imagenesExistentes">
          <% u.documentacion.imagenes.forEach((img, index) => { %>
            <div class="relative group">
              <div class="overflow-hidden rounded-lg shadow-sm">
                <img src="<%= img.path %>"
                     alt="Imagen <%= index + 1 %>"
                     class="h-32 w-full object-cover rounded-lg cursor-pointer transition hover:opacity-90"
                     data-src="<%= img.path %>">

                <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
                  <button type="button"
                    class="absolute top-1 right-1 bg-red-600 hover:bg-red-700 text-white rounded-full p-1 opacity-0 group-hover:opacity-100 transition"
                    onclick="event.stopPropagation(); eliminarImagen(this, '<%= u.uni %>', '<%= img.path %>')">
                    ✕
                  </button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- FILE UPLOAD -->
    <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
    <div class="flex justify-center px-6 pt-5 pb-6 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg">
      <div class="text-center space-y-2">

        <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4" />
        </svg>

        <label class="cursor-pointer text-indigo-600 dark:text-indigo-400 font-medium">
          <span>Subir imágenes</span>
          <input id="imagenes" name="imagenes" type="file" class="sr-only" multiple accept="image/*">
        </label>

        <p class="text-xs text-gray-500 dark:text-gray-400">PNG, JPG, GIF hasta 10MB</p>
      </div>
    </div>
    <% } %>

    <div id="imagePreview" class="grid grid-cols-2 md:grid-cols-3 gap-4"></div>

  </div>

  <!-- ============================= -->
  <!-- BOTONES -->
  <!-- ============================= -->
  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
  <div class="flex justify-end gap-x-3 pt-10 border-t border-gray-200 dark:border-gray-700">

    <button type="button" id="btnCancelar"
      class="rounded-md bg-white dark:bg-gray-700 px-4 py-2 text-sm font-semibold text-gray-900 dark:text-white shadow-sm ring-1 ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600">
      Cancelar
    </button>

    <button type="submit"
      class="rounded-md bg-indigo-600 hover:bg-indigo-500 px-4 py-2 text-sm font-semibold text-white shadow-sm">
      Guardar Cambios
    </button>

  </div>
  <% } %>

</form>

    </div>
  </div>
</div>

<!-- MODAL -->
<div id="imageModal"
  class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 hidden">
  <span id="closeModal" class="absolute top-4 right-4 text-white text-4xl cursor-pointer">&times;</span>
  <img id="modalImage" class="max-w-4xl max-h-[90vh] object-contain">
</div>

<!-- jsPDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>

<!-- Inyectar datos de la unidad para que JS los consuma -->
<script>
  window.unitData = {
    ...<%- JSON.stringify(u) %>,
    documentacion: <%- JSON.stringify(u.documentacion || {}) %>
  };
</script>

<script src="/js/detalle.js"></script>

<script>
  // Script para actualizar el color del selector al cambiar
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('estadoInforme');
    if (select) {
      select.addEventListener('change', function() {
        const val = this.value;
        // Limpiar clases de color específicas
        this.classList.remove(
          'border-red-500', 'text-red-700', 'dark:text-red-400', 'focus:border-red-500', 'focus:ring-red-500',
          'border-green-500', 'text-green-700', 'dark:text-green-400', 'focus:border-green-500', 'focus:ring-green-500',
          'border-yellow-500', 'text-yellow-700', 'dark:text-yellow-400', 'focus:border-yellow-500', 'focus:ring-yellow-500',
          'border-orange-500', 'text-orange-700', 'dark:text-orange-400', 'focus:border-orange-500', 'focus:ring-orange-500',
          'border-blue-500', 'text-blue-700', 'dark:text-blue-400', 'focus:border-blue-500', 'focus:ring-blue-500',
          'border-gray-300', 'dark:border-gray-600', 'dark:text-white', 'focus:border-indigo-500', 'focus:ring-indigo-500'
        );

        let newClasses = ['border-gray-300', 'dark:border-gray-600', 'dark:text-white', 'focus:border-indigo-500', 'focus:ring-indigo-500'];
        if (val === 'Trabajos urgentes') newClasses = ['border-red-500', 'text-red-700', 'dark:text-red-400', 'focus:border-red-500', 'focus:ring-red-500'];
        else if (val === 'Trabajos finalizados') newClasses = ['border-green-500', 'text-green-700', 'dark:text-green-400', 'focus:border-green-500', 'focus:ring-green-500'];
        else if (val === 'Trabajos en proceso') newClasses = ['border-yellow-500', 'text-yellow-700', 'dark:text-yellow-400', 'focus:border-yellow-500', 'focus:ring-yellow-500'];
        else if (val === 'Trabajos pendientes') newClasses = ['border-orange-500', 'text-orange-700', 'dark:text-orange-400', 'focus:border-orange-500', 'focus:ring-orange-500'];
        else if (val === 'Informe presentado por Co-propietario') newClasses = ['border-blue-500', 'text-blue-700', 'dark:text-blue-400', 'focus:border-blue-500', 'focus:ring-blue-500'];

        this.classList.add(...newClasses);
      });
    }
  });
</script>
