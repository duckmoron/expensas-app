<div class="space-y-8">
  
  <!-- Encabezado -->
  <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700">
    <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-2">
      Análisis de Gastos y Finanzas
    </h2>
    <p class="text-gray-600 dark:text-gray-400">
      Visualización histórica basada en los periodos procesados.
    </p>
  </div>

  <!-- SECCIÓN DE FILTROS -->
  <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200">Filtros de Análisis</h3>
      <button id="btnResetFilters" class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">Restablecer</button>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <!-- Rango de Fechas -->
      <div class="md:col-span-4 space-y-3">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Periodo</label>
        <div class="flex gap-2 items-center">
          <select id="periodoDesde" class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-sm py-2"></select>
          <span class="text-gray-500">➜</span>
          <select id="periodoHasta" class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-sm py-2"></select>
        </div>
      </div>

      <!-- Rubros -->
      <div class="md:col-span-8 space-y-3">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Rubros (Impacta en Gastos)</label>
        <div id="rubrosContainer" class="flex flex-wrap gap-2 max-h-32 overflow-y-auto p-3 border rounded-md border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
          <!-- Checkboxes generados por JS -->
        </div>

        <!-- Referencias de Rubros -->
        <details class="group">
          <summary class="text-xs text-indigo-600 dark:text-indigo-400 cursor-pointer hover:underline flex items-center gap-1 select-none w-fit mt-1">
            <span class="font-medium">Ver referencias de rubros</span>
          </summary>
          <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1 text-xs text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-900/50 p-3 rounded border border-gray-100 dark:border-gray-700">
            <div><span class="font-bold">Rubro 1:</span> Remuneraciones al personal y cargas sociales</div>
            <div><span class="font-bold">Rubro 2:</span> Servicios publicos</div>
            <div><span class="font-bold">Rubro 3:</span> Abonos de servicios</div>
            <div><span class="font-bold">Rubro 4:</span> Mantenimiento de partes comunes</div>
            <div><span class="font-bold">Rubro 6:</span> Gastos bancarios</div>
            <div><span class="font-bold">Rubro 7:</span> Gastos de limpieza</div>
            <div><span class="font-bold">Rubro 8:</span> Gastos de administracion</div>
            <div><span class="font-bold">Rubro 9:</span> Pagos del periodo por seguro</div>
          </div>
        </details>
      </div>
    </div>
  </div>

  <!-- KPIs (Indicadores Clave) -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-indigo-50 dark:bg-indigo-900/30 p-4 rounded-xl border border-indigo-100 dark:border-indigo-800">
      <p class="text-sm text-indigo-600 dark:text-indigo-300 font-medium">Gasto Acumulado (Sel.)</p>
      <p class="text-2xl font-bold text-indigo-800 dark:text-indigo-100" id="kpiGastoTotal">-</p>
    </div>
    <div class="bg-blue-50 dark:bg-blue-900/30 p-4 rounded-xl border border-blue-100 dark:border-blue-800">
      <p class="text-sm text-blue-600 dark:text-blue-300 font-medium">Promedio Gastos (Sel.)</p>
      <p class="text-2xl font-bold text-blue-800 dark:text-blue-100" id="kpiPromedio">-</p>
    </div>
    <div class="bg-emerald-50 dark:bg-emerald-900/30 p-4 rounded-xl border border-emerald-100 dark:border-emerald-800">
      <p class="text-sm text-emerald-600 dark:text-emerald-300 font-medium">Promedio Ingresos</p>
      <p class="text-2xl font-bold text-emerald-800 dark:text-emerald-100" id="kpiPromedioIngresos">-</p>
    </div>
    <div class="bg-red-50 dark:bg-red-900/30 p-4 rounded-xl border border-red-100 dark:border-red-800">
      <p class="text-sm text-red-600 dark:text-red-300 font-medium">Promedio Egresos</p>
      <p class="text-2xl font-bold text-red-800 dark:text-red-100" id="kpiPromedioEgresos">-</p>
    </div>
  </div>

  <!-- Gráfico 1: Evolución de Gastos Totales -->
  <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700">
    <h3 class="text-lg font-semibold mb-4 text-indigo-600 dark:text-indigo-400">Evolución del Gasto Total</h3>
    <div class="relative h-72 w-full">
      <canvas id="chartGastosTotal"></canvas>
    </div>
  </div>

  <!-- Gráfico: Evolución por Rubros -->
  <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700">
    <h3 class="text-lg font-semibold mb-4 text-indigo-600 dark:text-indigo-400">Evolución Detallada por Rubros</h3>
    <div class="relative h-72 w-full">
      <canvas id="chartRubrosEvolution"></canvas>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    <!-- Gráfico 2: Composición de Rubros (Último Periodo) -->
    <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700">
      <h3 class="text-lg font-semibold mb-4 text-indigo-600 dark:text-indigo-400">Distribución por Rubros (Promedio)</h3>
      <div class="relative h-72 w-full flex justify-center">
        <canvas id="chartRubros"></canvas>
      </div>
    </div>

    <!-- Gráfico 3: Finanzas (Ingresos vs Egresos) -->
    <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700">
      <h3 class="text-lg font-semibold mb-4 text-indigo-600 dark:text-indigo-400">Ingresos vs Egresos</h3>
      <div class="relative h-72 w-full">
        <canvas id="chartFinanzas"></canvas>
      </div>
    </div>

  </div>

  <!-- Gráfico: Evolución de Pagos y Cobranzas -->
  <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700 mt-8">
    <h3 class="text-lg font-semibold mb-4 text-indigo-600 dark:text-indigo-400">Evolución de Pagos y Cobranzas</h3>
    <div class="relative h-72 w-full">
      <canvas id="chartPagosCobranzas"></canvas>
    </div>
  </div>

  <!-- SECCIÓN EXPENSAS -->
  <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border border-gray-200 dark:border-gray-700 mt-8">
    <h2 class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-6">
      Análisis de Liquidación de Expensas
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Gráfico Total Expensas -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-indigo-600 dark:text-indigo-400">Total Expensas Generadas</h3>
        <div class="relative h-72 w-full">
          <canvas id="chartExpensasTotal"></canvas>
        </div>
      </div>

      <!-- Gráfico Por Unidad -->
      <div>
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-indigo-600 dark:text-indigo-400">Evolución por Unidad</h3>
          <select id="selectUnidad" class="rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-sm py-1 px-2 focus:ring-indigo-500 focus:border-indigo-500">
            <!-- Poblado por JS -->
          </select>
        </div>
        <div class="relative h-72 w-full">
          <canvas id="chartExpensasUnidad"></canvas>
        </div>
      </div>

    </div>
  </div>

</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Inyectar datos y lógica -->
<script>
  window.statsData = <%- statsData %>;
</script>
<script src="/js/estadisticas.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ctx = document.getElementById('chartPagosCobranzas');
    if (!ctx || !window.statsData) return;

    // 1. Pre-procesamiento: Convertir metadata de string a objeto si es necesario
    window.statsData.forEach(d => {
      if (d.metadata && typeof d.metadata === 'string') {
        try {
          d.metadata = JSON.parse(d.metadata);
        } catch (e) {
          console.error("Error parseando metadata para ID:", d.id, e);
          d.metadata = {};
        }
      }
    });

    const parseMoney = (val) => {
      if (!val) return 0;
      if (typeof val === 'number') return val;
      // Limpieza robusta: quitar puntos, cambiar coma por punto, eliminar caracteres no numéricos
      let clean = String(val).trim();
      clean = clean.replace(/\./g, ''); 
      clean = clean.replace(',', '.');
      // Permitir solo números, punto y signo menos (al inicio)
      clean = clean.replace(/[^0-9.-]/g, '');
      return parseFloat(clean) || 0; 
    };

    // Helper para buscar pagos_cobranzas donde sea que esté
    const getPC = (d) => {
      // 1. Intentar estructura original (metadata.dinamicos.pagos_cobranzas)
      if (d.metadata?.dinamicos?.pagos_cobranzas) return d.metadata.dinamicos.pagos_cobranzas;
      
      // 2. Intentar estructura 'finanzas' (detectada en debug)
      if (d.finanzas) {
        return {
          saldo_inicial: d.finanzas.saldo_inicial,
          ingresos_expensas: d.finanzas.ingresos_expensas || d.finanzas.ingresos,
          ingresos_atrasados: d.finanzas.ingresos_atrasados || 0,
          ingresos_intereses: d.finanzas.ingresos_intereses || 0,
          egresos: d.finanzas.egresos,
          saldo_final: d.finanzas.saldo_final
        };
      }

      // 3. Fallback a raiz
      return d.pagos_cobranzas || {};
    };

    // Obtener etiquetas (Periodos)
    const labels = window.statsData.map(d => {
      const root = d.metadata || d;
      return root.dinamicos?.aviso_pago?.periodo || root.periodo || 'Periodo';
    });

    const datasets = [
      {
        label: 'Saldo Inicial',
        data: window.statsData.map(d => parseMoney(getPC(d).saldo_inicial)),
        borderColor: '#6366f1', // Indigo
        backgroundColor: '#6366f1',
        tension: 0.3
      },
      {
        label: 'Ingresos Expensas',
        data: window.statsData.map(d => parseMoney(getPC(d).ingresos_expensas)),
        borderColor: '#10b981', // Emerald
        backgroundColor: '#10b981',
        tension: 0.3
      },
      {
        label: 'Ingresos Atrasados',
        data: window.statsData.map(d => parseMoney(getPC(d).ingresos_atrasados)),
        borderColor: '#f59e0b', // Amber
        backgroundColor: '#f59e0b',
        tension: 0.3
      },
      {
        label: 'Ingresos Intereses',
        data: window.statsData.map(d => parseMoney(getPC(d).ingresos_intereses)),
        borderColor: '#8b5cf6', // Violet
        backgroundColor: '#8b5cf6',
        tension: 0.3
      },
      {
        label: 'Egresos',
        data: window.statsData.map(d => parseMoney(getPC(d).egresos)),
        borderColor: '#ef4444', // Red
        backgroundColor: '#ef4444',
        tension: 0.3
      },
      {
        label: 'Saldo Final',
        data: window.statsData.map(d => parseMoney(getPC(d).saldo_final)),
        borderColor: '#3b82f6', // Blue
        backgroundColor: '#3b82f6',
        borderWidth: 3,
        tension: 0.3
      }
    ];

    new Chart(ctx, {
      type: 'line',
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        scales: { y: { ticks: { callback: (val) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumSignificantDigits: 3 }).format(val) } } },
        plugins: { tooltip: { callbacks: { label: (ctx) => (ctx.dataset.label || '') + ': ' + new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(ctx.parsed.y) } }, legend: { position: 'bottom' } }
      }
    });
  });
</script>