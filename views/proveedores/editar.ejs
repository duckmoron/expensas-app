<div class="max-w-4xl mx-auto p-6 mt-6">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 p-6">
            
            <div class="border-b border-gray-200 dark:border-gray-700 pb-4 mb-6">
                <h2 class="text-xl font-bold text-gray-800 dark:text-white flex items-center gap-2">
                    <span>✏️</span> Editar Proveedor
                </h2>
            </div>

            <% if (locals.error) { %>
                <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6" role="alert">
                    <p class="font-bold">Error</p>
                    <p><%= error %></p>
                </div>
            <% } %>

            <form action="/proveedores/editar/<%= proveedor.id %>" method="POST" class="space-y-6">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Nombre -->
                    <div class="col-span-1">
                        <label for="nombre" class="block text-sm font-medium mb-1">Nombre / Razón Social</label>
                        <input type="text" id="nombre" name="nombre" value="<%= proveedor.nombre %>" required
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- CUIT -->
                    <div class="col-span-1">
                        <label for="cuit" class="block text-sm font-medium mb-1">CUIT</label>
                        <input type="text" id="cuit" name="cuit" value="<%= proveedor.cuit %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Rubro -->
                    <div class="col-span-1">
                        <label for="rubro" class="block text-sm font-medium mb-1">Rubro</label>
                        
                        <!-- Inputs ocultos -->
                        <input type="hidden" id="rubroInput" name="rubro" value="<%= proveedor.rubro %>">
                        <input type="hidden" id="rubroColorInput" name="rubroColor" value="<%= proveedor.rubroColor || 'bg-gray-100 text-gray-800' %>">

                        <!-- UI de Selección -->
                        <div class="space-y-3">
                            <!-- Input visual y selector de color -->
                            <div class="flex gap-2">
                                <input type="text" id="rubroVisual" value="<%= proveedor.rubro %>" placeholder="Escribe o selecciona..."
                                    class="flex-1 px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition"
                                    oninput="syncRubro(this.value)">
                                
                                <!-- Muestra del color seleccionado -->
                                <div id="colorPreview" class="w-10 h-10 rounded border border-gray-300 dark:border-gray-600 flex items-center justify-center shadow-sm <%= proveedor.rubroColor || 'bg-gray-100 text-gray-800' %>">
                                    <span class="text-xs font-bold">Aa</span>
                                </div>
                            </div>

                            <!-- Paleta de colores -->
                            <div class="flex flex-wrap gap-2">
                                <% const colors = [
                                    { cls: 'bg-gray-100 text-gray-800', label: 'Gris' },
                                    { cls: 'bg-red-100 text-red-800', label: 'Rojo' },
                                    { cls: 'bg-yellow-100 text-yellow-800', label: 'Amarillo' },
                                    { cls: 'bg-green-100 text-green-800', label: 'Verde' },
                                    { cls: 'bg-blue-100 text-blue-800', label: 'Azul' },
                                    { cls: 'bg-indigo-100 text-indigo-800', label: 'Indigo' },
                                    { cls: 'bg-purple-100 text-purple-800', label: 'Violeta' },
                                    { cls: 'bg-pink-100 text-pink-800', label: 'Rosa' }
                                ]; %>
                                <% colors.forEach(c => { %>
                                    <button type="button" 
                                        class="w-6 h-6 rounded-full border border-gray-300 dark:border-gray-600 <%= c.cls %> hover:scale-110 transition-transform focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-indigo-500"
                                        onclick="selectColor('<%= c.cls %>')"
                                        title="<%= c.label %>">
                                    </button>
                                <% }) %>
                            </div>

                            <!-- Etiquetas existentes -->
                            <% if (locals.rubros && rubros.length > 0) { %>
                                <div class="text-xs text-gray-500 dark:text-gray-400">Existentes:</div>
                                <div class="flex flex-wrap gap-2 max-h-24 overflow-y-auto p-2 border rounded-md border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50">
                                    <% rubros.forEach(r => { %>
                                        <div class="inline-flex items-center rounded-md overflow-hidden border border-transparent hover:border-gray-300 transition group shadow-sm">
                                            <button type="button" 
                                                class="px-2 py-1 text-xs font-medium <%= r.color || 'bg-gray-100 text-gray-800' %>"
                                                onclick="selectRubro('<%= r.nombre %>', '<%= r.color %>')">
                                                <%= r.nombre %>
                                            </button>
                                            <button type="button"
                                                class="px-1.5 py-1 text-xs bg-gray-200 dark:bg-gray-600 text-gray-500 hover:text-red-100 hover:bg-red-600 dark:hover:bg-red-600 transition flex items-center justify-center"
                                                onclick="deleteRubro('<%= r.nombre %>', this)"
                                                title="Eliminar etiqueta">
                                                &times;
                                            </button>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Calificación -->
                    <div class="col-span-1">
                        <label class="block text-sm font-medium mb-1">Calificación</label>
                        <div class="flex flex-row-reverse justify-end gap-1 pt-1">
                            <% const currentStars = proveedor.estrellas || 0; %>
                            <% for(let i=5; i>=1; i--) { %>
                                <input type="radio" id="star<%= i %>" name="estrellas" value="<%= i %>" class="peer hidden" <%= currentStars == i ? 'checked' : '' %> />
                                <label for="star<%= i %>" class="text-2xl text-gray-300 peer-checked:text-yellow-400 hover:text-yellow-400 peer-hover:text-yellow-400 cursor-pointer transition-colors" title="<%= i %> estrellas">★</label>
                            <% } %>
                        </div>
                    </div>

                    <!-- Contacto -->
                    <div class="col-span-1">
                        <label for="contacto" class="block text-sm font-medium mb-1">Persona de Contacto</label>
                        <input type="text" id="contacto" name="contacto" value="<%= proveedor.contacto %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Dirección -->
                    <div class="col-span-1 md:col-span-2">
                        <label for="direccion" class="block text-sm font-medium mb-1">Dirección</label>
                        <input type="text" id="direccion" name="direccion" value="<%= proveedor.direccion %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Teléfono -->
                    <div class="col-span-1">
                        <label for="telefono" class="block text-sm font-medium mb-1">Teléfono</label>
                        <input type="text" id="telefono" name="telefono" value="<%= proveedor.telefono %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Email -->
                    <div class="col-span-1">
                        <label for="email" class="block text-sm font-medium mb-1">Email</label>
                        <input type="email" id="email" name="email" value="<%= proveedor.email %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Observaciones -->
                    <div class="col-span-1 md:col-span-2">
                        <label for="observaciones" class="block text-sm font-medium mb-1">Observaciones</label>
                        <textarea id="observaciones" name="observaciones" rows="3"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition"><%= proveedor.observaciones || '' %></textarea>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4">
                    <a href="/proveedores" class="px-4 py-2 rounded-md bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition">Cancelar</a>
                    <button type="submit" class="px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-500 shadow-sm transition">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

<script src="/js/proveedores_form.js"></script>