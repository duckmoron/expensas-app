            value="<%= u.documentacion?.telefono || '' %>"
            class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 py-2 px-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:text-white sm:text-sm">
        </div>
      </div>

    </div>
  </div>

  <!-- ============================= -->
  <!-- AREAS DE TEXTO -->
  <!-- ============================= -->
