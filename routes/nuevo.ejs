<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' }
    </script>
</head>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-200 transition-colors duration-300">
    
    <%- include('../partials/navbar') %>

    <div class="max-w-4xl mx-auto p-6 mt-6">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 p-6">
            
            <div class="border-b border-gray-200 dark:border-gray-700 pb-4 mb-6">
                <h2 class="text-xl font-bold text-gray-800 dark:text-white flex items-center gap-2">
                    <span>🆕</span> Nuevo Proveedor
                </h2>
            </div>

            <% if (locals.error) { %>
                <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6" role="alert">
                    <p class="font-bold">Error</p>
                    <p><%= error %></p>
                </div>
            <% } %>

            <form action="/proveedores/nuevo" method="POST" class="space-y-6">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Nombre -->
                    <div class="col-span-1">
                        <label for="nombre" class="block text-sm font-medium mb-1">Nombre / Razón Social</label>
                        <input type="text" id="nombre" name="nombre" required value="<%= locals.formData && formData.nombre ? formData.nombre : '' %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- CUIT -->
                    <div class="col-span-1">
                        <label for="cuit" class="block text-sm font-medium mb-1">CUIT</label>
                        <input type="text" id="cuit" name="cuit" placeholder="Ej: 20-12345678-9" value="<%= locals.formData && formData.cuit ? formData.cuit : '' %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Rubro -->
                    <div class="col-span-1">
                        <label for="rubro" class="block text-sm font-medium mb-1">Rubro</label>
                        <input type="text" id="rubro" name="rubro" placeholder="Ej: Plomería, Electricidad..." value="<%= locals.formData && formData.rubro ? formData.rubro : '' %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Contacto -->
                    <div class="col-span-1">
                        <label for="contacto" class="block text-sm font-medium mb-1">Persona de Contacto</label>
                        <input type="text" id="contacto" name="contacto" value="<%= locals.formData && formData.contacto ? formData.contacto : '' %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Dirección -->
                    <div class="col-span-1 md:col-span-2">
                        <label for="direccion" class="block text-sm font-medium mb-1">Dirección</label>
                        <input type="text" id="direccion" name="direccion" value="<%= locals.formData && formData.direccion ? formData.direccion : '' %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Teléfono -->
                    <div class="col-span-1">
                        <label for="telefono" class="block text-sm font-medium mb-1">Teléfono</label>
                        <input type="text" id="telefono" name="telefono" value="<%= locals.formData && formData.telefono ? formData.telefono : '' %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Email -->
                    <div class="col-span-1">
                        <label for="email" class="block text-sm font-medium mb-1">Email</label>
                        <input type="email" id="email" name="email" value="<%= locals.formData && formData.email ? formData.email : '' %>"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                    </div>

                    <!-- Observaciones -->
                    <div class="col-span-1 md:col-span-2">
                        <label for="observaciones" class="block text-sm font-medium mb-1">Observaciones</label>
                        <textarea id="observaciones" name="observaciones" rows="3"
                            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none transition"><%= locals.formData && formData.observaciones ? formData.observaciones : '' %></textarea>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4">
                    <a href="/proveedores" class="px-4 py-2 rounded-md bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition">Cancelar</a>
                    <button type="submit" class="px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-500 shadow-sm transition">Guardar Proveedor</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>